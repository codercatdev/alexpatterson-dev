<script>
	// 1. Inline Booking Drawer Toggle
	const toggleBtn = document.getElementById("booking-drawer-toggle");
	const panel = document.getElementById("booking-drawer-panel");
	const chevron = document.getElementById("booking-drawer-chevron");

	if (toggleBtn && panel) {
		const syncState = (isOpen: boolean) => {
			toggleBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
			if (chevron) {
				chevron.style.transform = isOpen ? "rotate(180deg)" : "rotate(0deg)";
			}
		};

		toggleBtn.addEventListener("click", () => {
			const isHidden = panel.hasAttribute("hidden");
			if (isHidden) {
				panel.removeAttribute("hidden");
				syncState(true);
			} else {
				panel.setAttribute("hidden", "until-found");
				syncState(false);
			}
		});

		panel.addEventListener("beforematch", () => {
			syncState(true);
		});
	}

	// 2. Mobile Navigation Drawer Toggle
	const mobileToggle = document.getElementById("mobile-nav-toggle");
	const mobileDrawer = document.getElementById("mobile-nav-drawer");
	const iconOpen = document.getElementById("mobile-nav-icon-open");
	const iconClose = document.getElementById("mobile-nav-icon-close");

	if (mobileToggle && mobileDrawer) {
		const setMobileOpen = (open: boolean) => {
			mobileDrawer.hidden = !open;
			mobileToggle.setAttribute("aria-expanded", String(open));
			iconOpen?.classList.toggle("hidden", open);
			iconClose?.classList.toggle("hidden", !open);
		};

		mobileToggle.addEventListener("click", () => {
			setMobileOpen(mobileDrawer.hidden);
		});

		mobileDrawer.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setMobileOpen(false));
		});
	}
</script>
