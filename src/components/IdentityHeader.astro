---
import {
	ArrowUpRight,
	Calendar,
	CheckCircle2,
	ExternalLink,
	FileJson,
	GraduationCap,
	Mail,
	MapPin,
	Plane,
	Radio,
	Sparkles,
	Terminal,
} from "lucide-react";
import type { SpeakerProfile } from "@/lib/sanity";

interface Props {
	profile: SpeakerProfile;
	sanityProjectId: string;
	sanityDataset: string;
}

const { profile, sanityProjectId, sanityDataset } = Astro.props;

const avatarSrc = profile.avatarUrl
	? `${profile.avatarUrl.split("?")[0]}?w=240&h=240&fit=crop&crop=focalpoint&fm=webp`
	: "/headshots/alex_headshot_1.jpg";
---

<header id="identity" class="scroll-mt-12">
	<!-- Section 00 Index Header -->
	<div class="flex items-center justify-between gap-4 pb-3 border-b border-zinc-800">
		<div class="flex items-center gap-2.5 font-mono text-xs tracking-wider uppercase text-zinc-400">
			<span class="text-violet-400 font-semibold">00</span>
			<span class="text-zinc-700">/</span>
			<span>IDENTITY</span>
		</div>
		<div class="flex items-center gap-3 font-mono text-[11px] text-zinc-400">
			{profile.availableForSpeaking && (
				<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-emerald-400">
					<span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
					Booking Keynotes &amp; Workshops
				</span>
			)}
			<span class="hidden sm:inline-flex items-center gap-1 text-zinc-500">
				<Terminal className="w-3 h-3 text-violet-400" />
				sanity:{sanityProjectId}/{sanityDataset}
			</span>
		</div>
	</div>

	<!-- Executive Identity Block -->
	<div class="mt-7 flex flex-col sm:flex-row items-start gap-5">
		<div class="relative shrink-0">
			<img
				src={avatarSrc}
				alt={`${profile.name} headshot`}
				width="88"
				height="88"
				fetchpriority="high"
				class="w-20 h-20 sm:w-22 sm:h-22 rounded-xl object-cover border border-zinc-800 bg-zinc-900 shadow-lg shadow-violet-950/20"
			/>
			<span
				title="MCP-Synced Speaker Profile"
				class="absolute -bottom-1.5 -right-1.5 inline-flex items-center gap-1 rounded-md bg-zinc-950 border border-violet-500/40 px-1.5 py-0.5 font-mono text-[10px] text-violet-300 shadow"
			>
				<Sparkles className="w-2.5 h-2.5 text-violet-400" />
				MCP
			</span>
		</div>

		<div class="flex-1 min-w-0">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100">
					{profile.name}
				</h1>
				<a
					href="/speaker-kit.json"
					class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-400 hover:text-violet-300 transition-colors border border-zinc-800/80 bg-zinc-900/50 hover:border-violet-500/40 rounded-md px-2.5 py-1"
				>
					<FileJson className="w-3.5 h-3.5 text-violet-400" />
					/speaker-kit.json
				</a>
			</div>

			<p class="mt-2 text-sm sm:text-base text-zinc-400 leading-relaxed">
				{profile.headline}
			</p>

			<!-- Education & Location Metadata -->
			<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-xs text-zinc-400">
				<span class="inline-flex items-center gap-1.5">
					<MapPin className="w-3.5 h-3.5 text-violet-400 shrink-0" />
					{profile.location}
				</span>
				<span class="text-zinc-700" aria-hidden="true">•</span>
				<span class="inline-flex items-center gap-1.5">
					<Plane className="w-3.5 h-3.5 text-zinc-500 shrink-0" />
					{profile.homeAirport}
				</span>
				<span class="text-zinc-700" aria-hidden="true">•</span>
				<span class="inline-flex items-center gap-1.5">
					<GraduationCap className="w-3.5 h-3.5 text-violet-400 shrink-0" />
					{profile.education}
				</span>
			</div>
		</div>
	</div>

	<!-- Role & Credential Badges (Monospace) -->
	<div class="mt-5 flex flex-wrap gap-2" aria-label="Role and Credential Badges">
		{profile.credentials.map((cred) => {
			const badgeClasses =
				cred.accent === "violet"
					? "bg-violet-500/10 border-violet-500/30 text-violet-200 hover:border-violet-400/60"
					: cred.accent === "emerald"
						? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300 hover:border-emerald-400/60"
						: "bg-zinc-900/70 border-zinc-800 text-zinc-300 hover:border-zinc-700";

			const dotClasses =
				cred.accent === "violet"
					? "bg-violet-400"
					: cred.accent === "emerald"
						? "bg-emerald-400"
						: "bg-zinc-500";

			return cred.url ? (
				<a
					href={cred.url}
					target="_blank"
					rel="noopener noreferrer"
					class={`inline-flex items-center gap-2 rounded-md border px-2.5 py-1 font-mono text-xs transition-colors ${badgeClasses}`}
				>
					<span class={`h-1.5 w-1.5 rounded-full ${dotClasses}`}></span>
					<span>{cred.label}</span>
					<ArrowUpRight className="w-3 h-3 opacity-60" />
				</a>
			) : (
				<span
					class={`inline-flex items-center gap-2 rounded-md border px-2.5 py-1 font-mono text-xs ${badgeClasses}`}
				>
					<span class={`h-1.5 w-1.5 rounded-full ${dotClasses}`}></span>
					<span>{cred.label}</span>
				</span>
			);
		})}
	</div>

	<!-- CodingCat.dev Referral Banner (Strictly Emerald Accent, No Routine Posts Ingested) -->
	<div class="mt-6 rounded-xl border border-emerald-500/30 bg-zinc-900/60 p-4 sm:p-5 relative overflow-hidden">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div class="space-y-1">
				<div class="flex items-center gap-2">
					<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 px-2.5 py-0.5 font-mono text-[11px] font-medium text-emerald-400">
						<Radio className="w-3 h-3" />
						MEDIA, TUTORIALS &amp; PODCAST HUB
					</span>
					<span class="font-mono text-[11px] text-zinc-500">
						codingcat.dev
					</span>
				</div>
				<p class="text-sm text-zinc-200 font-medium">
					Looking for tutorials, full-stack articles, or the CodingCat.dev Podcast?
				</p>
				<p class="text-xs text-zinc-400 leading-relaxed">
					This site is strictly my executive DevRel &amp; conference speaker kit. All video tutorials, courses, blog posts, and podcast episodes live exclusively on <span class="text-emerald-400 font-mono">codingcat.dev</span>.
				</p>
			</div>

			<a
				href={profile.socialLinks.codingcat}
				target="_blank"
				rel="noopener noreferrer"
				class="shrink-0 inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/40 px-4 py-2.5 font-mono text-xs font-semibold text-emerald-300 transition-all"
			>
				<span>Visit CodingCat.dev</span>
				<ExternalLink className="w-3.5 h-3.5" />
			</a>
		</div>
	</div>

	<!-- Primary Action Bar + Expandable Booking/Calendar Drawer -->
	<div class="mt-5 space-y-3">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<!-- Expandable Booking Trigger -->
			<div class="flex flex-wrap items-center gap-2.5">
				<button
					type="button"
					id="booking-drawer-toggle"
					aria-expanded="false"
					aria-controls="booking-drawer-panel"
					class="inline-flex items-center gap-2 rounded-lg bg-violet-600 hover:bg-violet-500 text-zinc-100 font-medium text-xs sm:text-sm px-4 py-2.5 shadow-sm shadow-violet-950/50 transition-colors cursor-pointer"
				>
					<Calendar className="w-4 h-4" />
					<span>Book Time / Invite to Speak</span>
					<span id="booking-drawer-chevron" class="font-mono text-xs text-violet-200 transition-transform duration-200">
						↓
					</span>
				</button>

				<a
					href="#speaker-kit"
					class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-800 bg-zinc-900/50 hover:bg-zinc-900 hover:border-zinc-700 px-3 py-2 font-mono text-xs text-zinc-300 transition-colors"
				>
					<span>Grab Bio &amp; Headshots</span>
				</a>
			</div>

			<!-- Quick Social Links -->
			<nav aria-label="Direct social profiles" class="flex flex-wrap items-center gap-1.5 font-mono text-xs">
				<a
					href={profile.socialLinks.github}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 rounded-md border border-zinc-800/80 bg-zinc-900/50 hover:border-violet-500/40 hover:text-zinc-100 px-2.5 py-1.5 text-zinc-400 transition-colors"
				>
					<span>GitHub</span>
					<span class="text-zinc-500">@codercatdev</span>
				</a>
				<a
					href={profile.socialLinks.x}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 rounded-md border border-zinc-800/80 bg-zinc-900/50 hover:border-violet-500/40 hover:text-zinc-100 px-2.5 py-1.5 text-zinc-400 transition-colors"
				>
					<span>X</span>
					<span class="text-zinc-500">@codercatdev</span>
				</a>
				<a
					href={profile.socialLinks.youtube}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 rounded-md border border-zinc-800/80 bg-zinc-900/50 hover:border-violet-500/40 hover:text-zinc-100 px-2.5 py-1.5 text-zinc-400 transition-colors"
				>
					<span>YouTube</span>
					<span class="text-zinc-500">@CodingCatDev</span>
				</a>
				<a
					href={profile.socialLinks.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 rounded-md border border-zinc-800/80 bg-zinc-900/50 hover:border-violet-500/40 hover:text-zinc-100 px-2.5 py-1.5 text-zinc-400 transition-colors"
				>
					<span>LinkedIn</span>
					<span class="text-zinc-500">/in/alexpatterson</span>
				</a>
			</nav>
		</div>

		<!-- Inline Expandable Booking / Calendar Drawer (uses hidden="until-found" for Find-in-Page accessibility) -->
		<div
			id="booking-drawer-panel"
			hidden="until-found"
		>
			<div class="rounded-xl border border-violet-500/30 bg-zinc-900/80 p-5 space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-800 pb-3">
					<div>
						<h2 class="text-sm font-semibold text-zinc-100 flex items-center gap-2">
							<Calendar className="w-4 h-4 text-violet-400" />
							Direct Booking &amp; Conference Speaker Inquiry
						</h2>
						<p class="text-xs text-zinc-400 mt-0.5">
							Select a channel below to book executive architecture time, invite Alex to keynote, or coordinate a hands-on workshop.
						</p>
					</div>
					<span class="font-mono text-[11px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 rounded px-2 py-0.5">
						Typical response &lt; 24h
					</span>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					<a
						href={profile.bookingUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-lg border border-zinc-800 bg-zinc-950/70 hover:border-violet-500/50 p-3.5 transition-all flex flex-col justify-between gap-2"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-mono text-violet-400">
								<span>01 / CALENDAR</span>
								<ArrowUpRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
							</div>
							<p class="mt-1.5 text-sm font-medium text-zinc-100">
								CodingCat.dev Booking Calendar
							</p>
							<p class="mt-1 text-xs text-zinc-400">
								Book a live slot for conference coordination, podcast guesting, or advisory sessions.
							</p>
						</div>
						<span class="font-mono text-[11px] text-violet-300">
							codingcat.dev/book →
						</span>
					</a>

					<a
						href={`mailto:${profile.speakerEmail}?subject=${encodeURIComponent("Speaking Inquiry — Alex Patterson (alexpatterson.dev)")}`}
						class="group rounded-lg border border-zinc-800 bg-zinc-950/70 hover:border-violet-500/50 p-3.5 transition-all flex flex-col justify-between gap-2"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-mono text-violet-400">
								<span>02 / DIRECT EMAIL</span>
								<Mail className="w-3.5 h-3.5" />
							</div>
							<p class="mt-1.5 text-sm font-medium text-zinc-100">
								Direct Speaker Inquiry
							</p>
							<p class="mt-1 text-xs text-zinc-400">
								Send event dates, location (or virtual setup), and travel/honorarium details directly.
							</p>
						</div>
						<span class="font-mono text-[11px] text-violet-300">
							{profile.speakerEmail} →
						</span>
					</a>

					<a
						href={profile.socialLinks.gdeProfile}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-lg border border-zinc-800 bg-zinc-950/70 hover:border-emerald-500/40 p-3.5 transition-all flex flex-col justify-between gap-2"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-mono text-emerald-400">
								<span>03 / GDE &amp; SANITY</span>
								<CheckCircle2 className="w-3.5 h-3.5" />
							</div>
							<p class="mt-1.5 text-sm font-medium text-zinc-100">
								GDE &amp; Enterprise Briefings
							</p>
							<p class="mt-1 text-xs text-zinc-400">
								Eligible for Google Developer Expert travel support &amp; Sanity architecture workshops.
							</p>
						</div>
						<span class="font-mono text-[11px] text-emerald-300">
							View GDE Profile →
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	const toggleBtn = document.getElementById("booking-drawer-toggle");
	const panel = document.getElementById("booking-drawer-panel");
	const chevron = document.getElementById("booking-drawer-chevron");

	if (toggleBtn && panel) {
		const syncState = (isOpen: boolean) => {
			toggleBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
			if (chevron) {
				chevron.style.transform = isOpen ? "rotate(180deg)" : "rotate(0deg)";
			}
		};

		toggleBtn.addEventListener("click", () => {
			const isHidden = panel.hasAttribute("hidden");
			if (isHidden) {
				panel.removeAttribute("hidden");
				syncState(true);
			} else {
				panel.setAttribute("hidden", "until-found");
				syncState(false);
			}
		});

		// Synchronize ARIA state if browser Find-in-Page reveals the drawer via beforematch
		panel.addEventListener("beforematch", () => {
			syncState(true);
		});
	}
</script>
