---
import {
	ArrowUpRight,
	Calendar,
	ExternalLink,
	GraduationCap,
	Mail,
	MapPin,
	Mic,
	Plane,
	Presentation,
	Sparkles,
	Video,
} from "lucide-react";
import AjHeadphones from "@/components/icons/AjHeadphones.astro";
import AjPrimaryAlt from "@/components/icons/AjPrimaryAlt.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { SpeakerProfile } from "@/lib/sanity";

interface Props {
	profile: SpeakerProfile;
}

const { profile } = Astro.props;

const heroPortraitSrc = profile.avatarUrl
	? `${profile.avatarUrl.split("?")[0]}?w=720&h=840&fit=crop&crop=focalpoint&fm=webp`
	: "/headshots/alex_headshot_1.jpg";
---

<!-- Sticky Glassmorphic Executive Top Navigation -->
<div class="sticky top-4 z-40 mb-10">
	<div class="rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/85 dark:bg-[#1b1e26]/85 backdrop-blur-md px-4 sm:px-6 py-3 shadow-sm shadow-slate-900/[0.04] dark:shadow-black/25 flex items-center justify-between gap-3">
		<div class="flex items-center gap-3 min-w-0">
			<a
				href="#identity"
				class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors truncate"
			>
				{profile.name}
			</a>
			{profile.availableForSpeaking && (
				<span class="hidden lg:inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 dark:bg-emerald-500/15 border border-emerald-500/25 px-2.5 py-0.5 text-[11px] font-medium text-emerald-700 dark:text-emerald-300">
					<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
					Open for Keynotes &amp; Sponsorships
				</span>
			)}
		</div>

		<nav aria-label="Primary section navigation" class="hidden md:flex items-center gap-5 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300">
			<a href="#partner" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
				Ways to Partner
			</a>
			<a
				href="https://codingcat.dev/sponsorships"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors"
			>
				<AjPrimaryAlt cls="w-4 h-4 shrink-0" />
				<span>Sponsorships</span>
			</a>
			<a href="#speaker-kit" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
				Speaker Kit
			</a>
			<a href="#headshots" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
				Headshots
			</a>
			<a href="#speaking-ledger" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
				Speaking
			</a>
		</nav>

		<div class="flex items-center gap-2 shrink-0">
			<ThemeToggle />
			<a
				href="#partner"
				class="inline-flex items-center gap-1.5 rounded-full bg-indigo-600 hover:bg-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-400 px-3.5 sm:px-4 py-1.5 text-xs sm:text-sm font-semibold text-white shadow-xs transition-colors"
			>
				<span>Partner / Book Alex</span>
			</a>
		</div>
	</div>
</div>

<header id="identity" role="banner" aria-label="Alex Patterson Executive Overview" class="scroll-mt-24">
	<!-- 2-Column Executive Hero Section -->
	<div class="rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-[#1b1e26] p-6 sm:p-10 shadow-sm shadow-slate-900/[0.03] dark:shadow-black/20">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
			<!-- Left Column: Positioning, Credentials & Primary CTAs -->
			<div class="lg:col-span-7 space-y-5">
				<div class="inline-flex flex-wrap items-center gap-2 rounded-full bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200/80 dark:border-indigo-400/30 px-3.5 py-1 text-xs font-medium text-indigo-700 dark:text-indigo-300">
					<Sparkles className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" />
					<span>Keynote Speaker • Podcast Host • YouTube Creator</span>
				</div>

				<div class="space-y-3">
					<p class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
						{profile.name} — Developer Relations &amp; Media Partnerships
					</p>
					<h1 class="text-3xl sm:text-4xl lg:text-[42px] font-bold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.12]">
						Helping developer brands tell authentic stories that convert.
					</h1>
				</div>

				<p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
					Whether you’re a <strong>CMO or DevRel lead</strong> launching a developer product through dedicated YouTube videos and podcasts, or a <strong>conference organizer</strong> booking a high-energy keynote or workshop—let’s build something developers genuinely trust.
				</p>

				<!-- Clean Role & Credential Pills (Featuring AJ's Tag Logo for CodingCat.dev) -->
				<div class="flex flex-wrap items-center gap-2 pt-1" aria-label="Executive Credentials">
					<a
						href="https://www.sanity.io"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-[#151820] hover:border-indigo-300 dark:hover:border-indigo-500/50 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
						<span>Senior Solutions Engineer @ Sanity</span>
					</a>

					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200/90 dark:border-emerald-500/30 bg-emerald-50/80 dark:bg-emerald-500/10 hover:border-emerald-400 px-3 py-1 text-xs font-medium text-emerald-800 dark:text-emerald-300 transition-colors"
					>
						<AjPrimaryAlt cls="w-4 h-4 shrink-0" />
						<span>Founder &amp; Host @ CodingCat.dev</span>
					</a>

					<a
						href={profile.socialLinks.gdeProfile}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-[#151820] hover:border-indigo-300 dark:hover:border-indigo-500/50 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
						<span>Google Developer Expert (GDE)</span>
					</a>

					<span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-[#151820] px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200">
						<GraduationCap className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" />
						<span>{profile.education}</span>
					</span>
				</div>

				<!-- Location & Travel Metadata -->
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-slate-500 dark:text-slate-400">
					<span class="inline-flex items-center gap-1.5">
						<MapPin className="w-3.5 h-3.5 text-indigo-500 dark:text-indigo-400 shrink-0" />
						Based in {profile.location}
					</span>
					<span aria-hidden="true">•</span>
					<span class="inline-flex items-center gap-1.5">
						<Plane className="w-3.5 h-3.5 text-slate-400 shrink-0" />
						Flying from {profile.homeAirport}
					</span>
					<span aria-hidden="true">•</span>
					<span>Broadcast-Grade Studio Available</span>
				</div>

				<!-- Primary CTA Buttons -->
				<div class="pt-2 flex flex-wrap items-center gap-3">
					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-400 px-5 py-3 text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 transition-all"
					>
						<AjPrimaryAlt cls="w-5 h-5 shrink-0" />
						<span>Explore CodingCat.dev Sponsorships</span>
						<ArrowUpRight className="w-4 h-4" />
					</a>

					<button
						type="button"
						id="booking-drawer-toggle"
						aria-expanded="false"
						aria-controls="booking-drawer-panel"
						toolname="toggle_booking_drawer"
						tooldescription="Open direct speaker booking calendar and inquiry contact options"
						tool-name="toggle_booking_drawer"
						tool-description="Open direct speaker booking calendar and inquiry contact options"
						class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-[#151820] hover:bg-slate-50 dark:hover:bg-slate-800/80 px-4 py-3 text-sm font-semibold text-slate-800 dark:text-slate-100 transition-colors cursor-pointer"
					>
						<Calendar className="w-4 h-4 text-indigo-600 dark:text-indigo-400" />
						<span>Book for Speaking / Podcast</span>
						<span id="booking-drawer-chevron" class="text-xs text-slate-400 transition-transform duration-200">
							↓
						</span>
					</button>
				</div>

				<!-- Quick Social & Speaker Kit Bar -->
				<div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 dark:border-slate-800/80 text-xs text-slate-500 dark:text-slate-400">
					<div class="flex flex-wrap items-center gap-3">
						<a href={profile.socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-300 font-medium transition-colors">
							YouTube (@CodingCatDev)
						</a>
						<span aria-hidden="true">•</span>
						<a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-300 font-medium transition-colors">
							LinkedIn (/in/alexpatterson)
						</a>
						<span aria-hidden="true">•</span>
						<a href={profile.socialLinks.x} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-300 font-medium transition-colors">
							X (@codercatdev)
						</a>
						<span aria-hidden="true">•</span>
						<a href={profile.socialLinks.github} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-300 font-medium transition-colors">
							GitHub
						</a>
					</div>

					<a
						href="#speaker-kit"
						class="inline-flex items-center gap-1 font-medium text-indigo-600 dark:text-indigo-300 hover:underline"
					>
						<span>Jump to Organizer Speaker Kit ↓</span>
					</a>
				</div>
			</div>

			<!-- Right Column: Studio Portrait + Floating Proof Badges -->
			<div class="lg:col-span-5">
				<div class="relative mx-auto max-w-sm lg:max-w-none">
					<!-- Soft decorative backdrop glow -->
					<div
						aria-hidden="true"
						class="absolute -inset-3 rounded-3xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/10 to-emerald-500/15 blur-xl"
					></div>

					<div class="relative rounded-2xl overflow-hidden border border-slate-200/90 dark:border-slate-700/80 bg-slate-100 dark:bg-[#151820] shadow-md aspect-[4/4.4]">
						<img
							src={heroPortraitSrc}
							alt={`${profile.name} — Keynote Speaker, Podcast Host, and Founder of CodingCat.dev`}
							width="480"
							height="528"
							fetchpriority="high"
							class="w-full h-full object-cover object-center"
						/>
					</div>

					<!-- Floating Proof Badge 1: 61.2K+ YouTube Subscribers (with AJ Tag Logo) -->
					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="absolute -top-3 -left-3 sm:-left-5 rounded-2xl border border-slate-200/90 dark:border-slate-700/90 bg-white/95 dark:bg-[#1b1e26]/95 backdrop-blur-md px-3.5 py-2.5 shadow-lg flex items-center gap-2.5 hover:scale-[1.02] transition-transform"
					>
						<AjPrimaryAlt cls="w-8 h-8 shrink-0" />
						<div>
							<div class="text-base sm:text-lg font-extrabold tracking-tight text-slate-900 dark:text-white leading-none">
								61.2K+
							</div>
							<div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">
								YouTube Subscribers
							</div>
						</div>
					</a>

					<!-- Floating Proof Badge 2: 405K+ Video Views (with AJ Headphones Logo) -->
					<a
						href="https://codingcat.dev"
						target="_blank"
						rel="noopener noreferrer"
						class="absolute top-1/2 -translate-y-1/2 -right-3 sm:-right-5 rounded-2xl border border-slate-200/90 dark:border-slate-700/90 bg-white/95 dark:bg-[#1b1e26]/95 backdrop-blur-md px-3.5 py-2.5 shadow-lg flex items-center gap-2.5 hover:scale-[1.02] transition-transform"
					>
						<AjHeadphones cls="w-8 h-8 shrink-0" />
						<div>
							<div class="text-base sm:text-lg font-extrabold tracking-tight text-slate-900 dark:text-white leading-none">
								405K+
							</div>
							<div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">
								Video &amp; Podcast Views
							</div>
						</div>
					</a>

					<!-- Floating Proof Badge 3: Global Stages -->
					<a
						href="#speaking-ledger"
						class="absolute -bottom-3 left-4 sm:left-6 rounded-2xl border border-slate-200/90 dark:border-slate-700/90 bg-white/95 dark:bg-[#1b1e26]/95 backdrop-blur-md px-3.5 py-2.5 shadow-lg flex items-center gap-2.5 hover:scale-[1.02] transition-transform"
					>
						<span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-500/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-300">
							<Mic className="w-4 h-4" />
						</span>
						<div>
							<div class="text-base sm:text-lg font-extrabold tracking-tight text-slate-900 dark:text-white leading-none">
								25+ Stages
							</div>
							<div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">
								Keynotes &amp; Workshops
							</div>
						</div>
					</a>
				</div>
			</div>
		</div>

		<!-- Inline Expandable Booking / Calendar Drawer (hidden="until-found" for Find-in-Page accessibility) -->
		<div id="booking-drawer-panel" hidden="until-found" class="mt-6">
			<div class="rounded-2xl border border-indigo-200/90 dark:border-indigo-500/30 bg-indigo-50/50 dark:bg-[#151820] p-5 sm:p-6 space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/80 dark:border-slate-800 pb-3">
					<div>
						<h2 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
							<Calendar className="w-4 h-4 text-indigo-600 dark:text-indigo-400" />
							Book Alex or Start a CodingCat.dev Sponsorship
						</h2>
						<p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
							Choose the fastest path for your team—whether you’re planning a product launch, podcast tour, or developer conference.
						</p>
					</div>
					<span class="text-xs font-medium text-emerald-700 dark:text-emerald-300 bg-emerald-500/10 border border-emerald-500/25 rounded-full px-3 py-1">
						Typical response &lt; 24 hours
					</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] hover:border-emerald-400 dark:hover:border-emerald-500/50 p-4 transition-all flex flex-col justify-between gap-3 shadow-xs"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-semibold text-emerald-700 dark:text-emerald-300">
								<span class="inline-flex items-center gap-1.5">
									<AjPrimaryAlt cls="w-5 h-5" />
									<span>SPONSORSHIPS &amp; VIDEO</span>
								</span>
								<ArrowUpRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
							</div>
							<p class="mt-2 text-sm font-bold text-slate-900 dark:text-slate-100">
								CodingCat.dev Sponsorships
							</p>
							<p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
								Dedicated YouTube product videos, podcast sponsorships, and multi-channel launch bundles.
							</p>
						</div>
						<span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300">
							codingcat.dev/sponsorships →
						</span>
					</a>

					<a
						href={profile.bookingUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] hover:border-indigo-400 dark:hover:border-indigo-500/50 p-4 transition-all flex flex-col justify-between gap-3 shadow-xs"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-semibold text-indigo-600 dark:text-indigo-300">
								<span class="inline-flex items-center gap-1.5">
									<AjHeadphones cls="w-5 h-5" />
									<span>LIVE CALENDAR</span>
								</span>
								<ArrowUpRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
							</div>
							<p class="mt-2 text-sm font-bold text-slate-900 dark:text-slate-100">
								Book a Discovery Call
							</p>
							<p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
								Grab a live slot on Alex’s calendar to discuss conference keynotes, podcast hosting, or campaign goals.
							</p>
						</div>
						<span class="text-xs font-semibold text-indigo-600 dark:text-indigo-300">
							codingcat.dev/book →
						</span>
					</a>

					<a
						href={`mailto:${profile.speakerEmail}?subject=${encodeURIComponent("Speaking & Partnership Inquiry — Alex Patterson")}`}
						class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] hover:border-indigo-400 dark:hover:border-indigo-500/50 p-4 transition-all flex flex-col justify-between gap-3 shadow-xs"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-semibold text-indigo-600 dark:text-indigo-300">
								<span>DIRECT EMAIL</span>
								<Mail className="w-4 h-4" />
							</div>
							<p class="mt-2 text-sm font-bold text-slate-900 dark:text-slate-100">
								Direct Speaker &amp; Brand Inquiry
							</p>
							<p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
								Send event dates, location, podcast topic, or sponsorship timeline directly to Alex’s inbox.
							</p>
						</div>
						<span class="text-xs font-semibold text-indigo-600 dark:text-indigo-300">
							{profile.speakerEmail} →
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- 4-Pillar "Ways to Partner" Bento Grid (Designed for CMOs, Marketing Leads & Event Organizers) -->
	<section id="partner" aria-labelledby="partner-heading" class="mt-12 scroll-mt-24">
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
			<div>
				<p class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
					For CMOs, DevRel Leads &amp; Event Organizers
				</p>
				<h2 id="partner-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mt-1">
					How We Can Partner Together
				</h2>
			</div>
			<a
				href="https://codingcat.dev/sponsorships"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-indigo-600 dark:text-indigo-300 hover:underline"
			>
				<AjPrimaryAlt cls="w-5 h-5" />
				<span>View Full Media Kit &amp; Sponsorship Bundles</span>
				<ArrowUpRight className="w-4 h-4" />
			</a>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			<!-- Card 1: Conference Keynotes & Workshops -->
			<article class="rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-[#1b1e26] p-5 shadow-xs flex flex-col justify-between gap-4 hover:border-indigo-300 dark:hover:border-indigo-500/50 transition-all">
				<div class="space-y-3">
					<div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200/70 dark:border-indigo-500/30 text-indigo-600 dark:text-indigo-300">
						<Presentation className="w-5 h-5" />
					</div>
					<span class="block text-[11px] font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
						Flagship Events &amp; Summits
					</span>
					<h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 leading-snug">
						Conference Keynotes &amp; Workshops
					</h3>
					<p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
						High-energy mainstage keynotes, hands-on architecture workshops, and MC hosting that leave developers inspired and ready to build.
					</p>
				</div>
				<a
					href="#speaker-kit"
					class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-300 hover:underline pt-2 border-t border-slate-100 dark:border-slate-800/80"
				>
					<span>Browse Ready-to-Run Talks</span>
					<span aria-hidden="true">↓</span>
