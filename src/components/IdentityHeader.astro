---
import {
	ArrowUpRight,
	Calendar,
	ExternalLink,
	Mail,
	MapPin,
	Menu,
	Mic,
	Plane,
	Presentation,
	Sparkles,
	Video,
	X,
} from "lucide-react";
import AjHeadphones from "@/components/icons/AjHeadphones.astro";
import AjPrimaryAlt from "@/components/icons/AjPrimaryAlt.astro";
import AwsLogo from "@/components/icons/AwsLogo.astro";
import SocialIconsBar from "@/components/SocialIconsBar.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { SpeakerProfile } from "@/lib/sanity";

interface Props {
	profile: SpeakerProfile;
}

const { profile } = Astro.props;

// Use optimized WebP portrait (32 KB @ 640w, 73 KB @ 1000w) for ultra-fast LCP
const heroPortraitSrc = "/headshots/alex_studio_mic-640.webp";
---

<!-- Sticky Glassmorphic Executive Top Navigation -->
<div class="sticky top-3 z-40 mb-8 sm:mb-10 w-full max-w-full">
	<div class="w-full max-w-full box-border overflow-hidden rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/90 dark:bg-[#1b1e26]/90 backdrop-blur-md px-3.5 sm:px-5 py-2.5 sm:py-3 shadow-sm shadow-slate-900/[0.04] dark:shadow-black/25">
		<div class="flex items-center justify-between gap-2 lg:gap-3 min-w-0">
			<!-- Brand Wordmark (Never Truncated) -->
			<a
				href="#identity"
				class="inline-flex items-center gap-2 text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors whitespace-nowrap shrink-0"
			>
				{profile.availableForSpeaking && (
					<span
						title="Available for Speaking & Sponsorships"
						class="h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400 shrink-0"
					></span>
				)}
				<span>{profile.name}</span>
			</a>

			<!-- Desktop Navigation Links (Single Line, Never Overflowing) -->
			<nav
				aria-label="Primary section navigation"
				class="hidden lg:flex items-center lg:gap-3.5 xl:gap-5 text-xs xl:text-sm font-medium text-slate-700 dark:text-slate-200 whitespace-nowrap min-w-0"
			>
				<a
					href="#partner"
					class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors whitespace-nowrap"
				>
					Ways to Partner
				</a>
				<a
					href="https://codingcat.dev/sponsorships"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors whitespace-nowrap"
				>
					<AjPrimaryAlt cls="w-4 h-4 shrink-0" />
					<span>Sponsorships</span>
				</a>
				<a
					href="#speaker-kit"
					class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors whitespace-nowrap"
				>
					Speaker Kit
				</a>
				<a
					href="#headshots"
					class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors whitespace-nowrap"
				>
					Headshots
				</a>
				<a
					href="#speaking-ledger"
					class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors whitespace-nowrap"
				>
					Speaking
				</a>
			</nav>

			<!-- Right Actions: Theme Switcher, Primary CTA & Mobile Menu Toggle -->
			<div class="flex items-center gap-2 shrink-0 whitespace-nowrap">
				<ThemeToggle />
				<a
					href="#partner"
					class="inline-flex items-center gap-1.5 rounded-full bg-indigo-600 hover:bg-indigo-500 px-3 sm:px-3.5 xl:px-4 py-1.5 text-xs xl:text-sm font-semibold text-white shadow-xs transition-colors whitespace-nowrap"
				>
					<span class="sm:hidden">Partner</span>
					<span class="hidden sm:inline">Partner / Book Alex</span>
				</a>
				<button
					type="button"
					id="mobile-nav-toggle"
					aria-expanded="false"
					aria-controls="mobile-nav-drawer"
					aria-label="Toggle navigation menu"
					class="lg:hidden inline-flex items-center justify-center rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 p-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
				>
					<Menu id="mobile-nav-icon-open" className="w-4 h-4" />
					<X id="mobile-nav-icon-close" className="w-4 h-4 hidden" />
				</button>
			</div>
		</div>

		<!-- Expandable Mobile & Tablet Navigation Menu (< lg) -->
		<nav
			id="mobile-nav-drawer"
			hidden
			aria-label="Mobile section navigation"
			class="lg:hidden mt-3 pt-3 border-t border-slate-200/80 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-sm font-medium"
		>
			<a
				href="#partner"
				class="mobile-nav-link rounded-xl px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors"
			>
				Ways to Partner
			</a>
			<a
				href="https://codingcat.dev/sponsorships"
				target="_blank"
				rel="noopener noreferrer"
				class="mobile-nav-link inline-flex items-center gap-2 rounded-xl px-3 py-2 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-50/70 dark:hover:bg-emerald-500/10 transition-colors"
			>
				<AjPrimaryAlt cls="w-4 h-4 shrink-0" />
				<span>CodingCat.dev Sponsorships ↗</span>
			</a>
			<a
				href="#speaker-kit"
				class="mobile-nav-link rounded-xl px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors"
			>
				Speaker Kit &amp; Bios
			</a>
			<a
				href="#headshots"
				class="mobile-nav-link rounded-xl px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors"
			>
				Official Press Headshots
			</a>
			<a
				href="#speaking-ledger"
				class="mobile-nav-link rounded-xl px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors"
			>
				Speaking Track Record
			</a>
			<a
				href="/contact"
				class="mobile-nav-link rounded-xl px-3 py-2 text-indigo-600 dark:text-indigo-300 hover:bg-indigo-50/70 dark:hover:bg-indigo-500/10 transition-colors"
			>
				Direct Contact &amp; Calendar
			</a>
		</nav>
	</div>
</div>

<header id="identity" role="banner" aria-label="Alex Patterson Executive Overview" class="scroll-mt-24">
	<!-- 2-Column Executive Hero Section -->
	<div class="rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-[#1b1e26] p-5 sm:p-8 lg:p-10 shadow-sm shadow-slate-900/[0.03] dark:shadow-black/20">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
			<!-- Left Column: Positioning, Credentials & Primary CTAs -->
			<div class="lg:col-span-7 space-y-5">
				<div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200/80 dark:border-indigo-400/30 px-3 sm:px-3.5 py-1 text-[11px] sm:text-xs font-semibold text-indigo-700 dark:text-indigo-300">
					<Sparkles className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" />
					<span>Keynote Speaker • Podcast Host • YouTube Creator</span>
				</div>

				<div class="space-y-2.5">
					<p class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-300">
						{profile.name} • Developer Relations &amp; Media Partnerships
					</p>
					<h1 class="text-3xl sm:text-4xl lg:text-[42px] font-bold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.12]">
						Helping developer brands tell authentic stories that convert.
					</h1>
				</div>

				<p class="text-sm sm:text-base lg:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
					Whether you’re a <strong>CMO or DevRel lead</strong> launching a developer product through dedicated YouTube videos and podcasts, or a <strong>conference organizer</strong> booking a high-energy keynote or workshop, let’s build something developers genuinely trust.
				</p>

				<!-- Clean Role & Credential Pills (Featuring AJ's Tag Logo for CodingCat.dev) -->
				<div class="flex flex-wrap items-center gap-2 pt-1" aria-label="Executive Credentials">
					<a
						href="https://www.sanity.io"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-[#151820] hover:border-indigo-300 dark:hover:border-indigo-500/50 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-indigo-500 shrink-0"></span>
						<span>Senior Solutions Architect @ Sanity</span>
					</a>

					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200/90 dark:border-emerald-500/30 bg-emerald-50/80 dark:bg-emerald-500/10 hover:border-emerald-400 px-3 py-1 text-xs font-medium text-emerald-800 dark:text-emerald-300 transition-colors"
					>
						<AjPrimaryAlt cls="w-4 h-4 shrink-0" />
						<span>Founder &amp; Host @ CodingCat.dev</span>
					</a>

					<a
						href={profile.socialLinks.gdeProfile}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-[#151820] hover:border-indigo-300 dark:hover:border-indigo-500/50 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-indigo-500 shrink-0"></span>
						<span>Google Developer Expert (GDE)</span>
					</a>

					<a
						href={profile.socialLinks.aws || "https://builder.aws.com/community/@codingcatdev"}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-[#151820] hover:border-indigo-300 dark:hover:border-indigo-500/50 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors"
					>
						<AwsLogo cls="h-3.5 w-auto text-slate-800 dark:text-slate-100 shrink-0" />
						<span>AWS Community Builder</span>
					</a>
				</div>

				<!-- Location & Travel Metadata -->
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-slate-600 dark:text-slate-300">
					<span class="inline-flex items-center gap-1.5">
						<MapPin className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" />
						Based in {profile.location}
					</span>
					<span aria-hidden="true">•</span>
					<span class="inline-flex items-center gap-1.5">
						<Plane className="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 shrink-0" />
						Flying from {profile.homeAirport}
					</span>
					<span aria-hidden="true">•</span>
					<span>Broadcast-Grade Studio Available</span>
				</div>

				<!-- Primary CTA Buttons -->
				<div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 px-5 py-3 text-xs sm:text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 transition-all whitespace-nowrap"
					>
						<AjPrimaryAlt cls="w-5 h-5 shrink-0" />
						<span>Explore CodingCat.dev Sponsorships</span>
						<ArrowUpRight className="w-4 h-4 shrink-0" />
					</a>

					<button
						type="button"
						id="booking-drawer-toggle"
						aria-expanded="false"
						aria-controls="booking-drawer-panel"
						toolname="toggle_booking_drawer"
						tooldescription="Open direct speaker booking calendar and inquiry contact options"
						tool-name="toggle_booking_drawer"
						tool-description="Open direct speaker booking calendar and inquiry contact options"
						class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-[#151820] hover:bg-slate-50 dark:hover:bg-slate-800/80 px-4 py-3 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 transition-colors cursor-pointer whitespace-nowrap"
					>
						<Calendar className="w-4 h-4 text-indigo-600 dark:text-indigo-400 shrink-0" />
						<span>Book for Speaking / Podcast</span>
						<span id="booking-drawer-chevron" class="text-xs text-slate-500 dark:text-slate-400 transition-transform duration-200">
							↓
						</span>
					</button>
				</div>

				<!-- Quick Social Icons & Speaker Kit Bar -->
				<div class="pt-3 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 dark:border-slate-800/80 text-xs text-slate-600 dark:text-slate-300">
					<SocialIconsBar socialLinks={profile.socialLinks} sizeClass="h-5 sm:h-6" />

					<a
						href="#speaker-kit"
						class="inline-flex items-center gap-1 font-semibold text-indigo-600 dark:text-indigo-300 hover:underline"
					>
						<span>Jump to Organizer Speaker Kit ↓</span>
					</a>
				</div>
			</div>

			<!-- Right Column: High-Res Studio Portrait + Unobstructed Proof Dock -->
			<div class="lg:col-span-5">
				<div class="relative mx-auto max-w-sm lg:max-w-none space-y-3">
					<!-- Soft decorative backdrop glow -->
					<div
						aria-hidden="true"
						class="
						absolute -inset-2 rounded-3xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/10 to-emerald-500/15 blur-xl pointer-events-none"
					></div>

					<!-- Portrait Card (Face, Mic & AJ Shirt 100% Unobstructed) -->
					<div class="relative rounded-2xl overflow-hidden border border-slate-200/90 dark:border-slate-700/80 bg-slate-100 dark:bg-[#151820] shadow-md aspect-square">
						<img
							src={heroPortraitSrc}
							srcset="/headshots/alex_studio_mic-640.webp 640w, /headshots/alex_studio_mic.webp 1000w"
							sizes="(max-width: 1024px) 100vw, 380px"
							alt={`${profile.name} — Keynote Speaker, Podcast Host, and Founder of CodingCat.dev`}
							width="640"
							height="640"
							fetchpriority="high"
							class="w-full h-full object-cover object-center"
						/>
						<div class="absolute top-3 right-3">
							<span class="inline-flex items-center gap-1.5 rounded-full bg-white/95 dark:bg-slate-900/90 backdrop-blur-md border border-slate-200/80 dark:border-slate-700/80 px-3 py-1 text-[11px] font-semibold text-slate-900 dark:text-slate-100 shadow-xs">
								<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
								Booking Keynotes, Video &amp; Podcasts
							</span>
						</div>
					</div>

					<!-- 3-Column Audience & Stage Proof Dock (Below Portrait — Never Blocks Face) -->
					<div class="relative grid grid-cols-3 gap-2 sm:gap-2.5">
						<a
							href="https://codingcat.dev/sponsorships"
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-xl border border-slate-200/90 dark:border-slate-700/90 bg-slate-50/90 dark:bg-[#151820] hover:border-indigo-400 p-2.5 sm:p-3 text-center transition-colors shadow-2xs"
						>
							<div class="flex items-center justify-center gap-1.5">
								<AjPrimaryAlt cls="w-4 h-4 sm:w-5 sm:h-5 shrink-0" />
								<span class="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
									61.2K+
								</span>
							</div>
							<div class="text-[10px] sm:text-[11px] font-medium text-slate-600 dark:text-slate-300 mt-0.5 leading-tight">
								YouTube Subs
							</div>
						</a>

						<a
							href="https://codingcat.dev"
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-xl border border-slate-200/90 dark:border-slate-700/90 bg-slate-50/90 dark:bg-[#151820] hover:border-emerald-400 p-2.5 sm:p-3 text-center transition-colors shadow-2xs"
						>
							<div class="flex items-center justify-center gap-1.5">
								<AjHeadphones cls="w-4 h-4 sm:w-5 sm:h-5 shrink-0" />
								<span class="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
									405K+
								</span>
							</div>
							<div class="text-[10px] sm:text-[11px] font-medium text-slate-600 dark:text-slate-300 mt-0.5 leading-tight">
								Video Views
							</div>
						</a>

						<a
							href="#speaking-ledger"
							class="rounded-xl border border-slate-200/90 dark:border-slate-700/90 bg-slate-50/90 dark:bg-[#151820] hover:border-indigo-400 p-2.5 sm:p-3 text-center transition-colors shadow-2xs"
						>
							<div class="flex items-center justify-center gap-1">
								<Mic className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-indigo-600 dark:text-indigo-400 shrink-0" />
								<span class="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
									25+
								</span>
							</div>
							<div class="text-[10px] sm:text-[11px] font-medium text-slate-600 dark:text-slate-300 mt-0.5 leading-tight">
								Global Stages
							</div>
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Inline Expandable Booking / Calendar Drawer (hidden="until-found" for Find-in-Page accessibility) -->
		<div id="booking-drawer-panel" hidden="until-found" class="mt-6">
			<div class="rounded-2xl border border-indigo-200/90 dark:border-indigo-500/30 bg-indigo-50/50 dark:bg-[#151820] p-5 sm:p-6 space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/80 dark:border-slate-800 pb-3">
					<div>
						<h2 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
							<Calendar className="w-4 h-4 text-indigo-600 dark:text-indigo-400" />
							Book Alex or Start a CodingCat.dev Sponsorship
						</h2>
						<p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5">
							Choose the fastest path for your team—whether you’re planning a product launch, podcast tour, or developer conference.
						</p>
					</div>
					<span class="text-xs font-semibold text-emerald-800 dark:text-emerald-300 bg-emerald-500/10 border border-emerald-500/25 rounded-full px-3 py-1">
						Typical response &lt; 24 hours
					</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<a
						href="https://codingcat.dev/sponsorships"
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] hover:border-emerald-400 dark:hover:border-emerald-500/50 p-4 transition-all flex flex-col justify-between gap-3 shadow-xs"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-semibold text-emerald-700 dark:text-emerald-300">
								<span class="inline-flex items-center gap-1.5">
									<AjPrimaryAlt cls="w-5 h-5" />
									<span>SPONSORSHIPS &amp; VIDEO</span>
								</span>
								<ArrowUpRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
							</div>
							<p class="mt-2 text-sm font-bold text-slate-900 dark:text-slate-100">
								CodingCat.dev Sponsorships
							</p>
							<p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
								Dedicated YouTube product videos, podcast sponsorships, and multi-channel launch bundles.
							</p>
						</div>
						<span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300">
							codingcat.dev/sponsorships →
						</span>
					</a>

					<a
						href={profile.bookingUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] hover:border-indigo-400 dark:hover:border-indigo-500/50 p-4 transition-all flex flex-col justify-between gap-3 shadow-xs"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-semibold text-indigo-600 dark:text-indigo-300">
								<span class="inline-flex items-center gap-1.5">
									<AjHeadphones cls="w-5 h-5" />
									<span>LIVE CALENDAR</span>
								</span>
								<ArrowUpRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
							</div>
							<p class="mt-2 text-sm font-bold text-slate-900 dark:text-slate-100">
								Book a Discovery Call
							</p>
							<p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
								Grab a live slot on Alex’s calendar to discuss conference keynotes, podcast hosting, or campaign goals.
							</p>
						</div>
						<span class="text-xs font-semibold text-indigo-600 dark:text-indigo-300">
							codingcat.dev/book →
						</span>
					</a>

					<a
						href={`mailto:${profile.speakerEmail}?subject=${encodeURIComponent("Speaking & Partnership Inquiry — Alex Patterson")}`}
						class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] hover:border-indigo-400 dark:hover:border-indigo-500/50 p-4 transition-all flex flex-col justify-between gap-3 shadow-xs"
					>
						<div>
							<div class="flex items-center justify-between text-xs font-semibold text-indigo-600 dark:text-indigo-300">
								<span>DIRECT EMAIL</span>
