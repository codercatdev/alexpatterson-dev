---

<div class="flex flex-wrap items-center gap-3.5 sm:gap-4" aria-label="Alex Patterson Social Links">
	{items.map((item) => (
		<a
			href={item.href}
			target="_blank"
			rel="noopener noreferrer"
			title={item.label}
			aria-label={item.label}
			class="inline-flex items-center justify-center text-slate-700 hover:text-indigo-600 dark:text-slate-100 dark:hover:text-indigo-400 transition-colors"
		>
			<svg
				class={`${sizeClass} w-auto block`}
				viewBox={item.viewBox}
				fill="currentColor"
				aria-hidden="true"
			>
				<path d={item.path} />
			</svg>
			<span class="sr-only">{item.label}</span>
		</a>
	))}
</div>
