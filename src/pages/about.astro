---
import { env } from "cloudflare:workers";
import { Font } from "astro:assets";
import AjHeadphones from "@/components/icons/AjHeadphones.astro";
import AjPrimaryAlt from "@/components/icons/AjPrimaryAlt.astro";
import SocialIconsBar from "@/components/SocialIconsBar.astro";
import ThemeScript from "@/components/ThemeScript.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getSpeakerKitData } from "@/lib/sanity";
import "@/styles/global.css";

const runtimeEnv = env as unknown as Record<string, unknown>;
const data = await getSpeakerKitData(runtimeEnv);
const origin = Astro.locals.siteUrl?.origin ?? "https://alexpatterson.dev";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ThemeScript />
		<title>About Alex Patterson | Keynote Speaker, Podcast Host &amp; Founder of CodingCat.dev</title>
		<meta
			name="description"
			content="About Alex Patterson: Senior Solutions Architect at Sanity.io, Founder & Host of CodingCat.dev, Google Developer Expert (GDE), M.S. from Grand Valley State University (GVSU), and international technical conference speaker."
		/>
		<link rel="canonical" href={`${origin}/about`} />
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-jetbrains-mono" />
	</head>
	<body class="min-h-dvh bg-[#faf9f6] dark:bg-[#13151a] text-slate-900 dark:text-slate-100 antialiased">
		<main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 space-y-8">
			<header role="banner" class="pb-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3">
				<a href="/" class="text-sm font-semibold text-indigo-600 dark:text-indigo-300 hover:underline">
					← Back to Alex Patterson Hub
				</a>
				<ThemeToggle />
			</header>

			<article class="space-y-6">
				<h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-100">
					About {data.profile.name}
				</h1>
				<p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-line">
					{data.profile.bios.fullThird}
				</p>

				<section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1b1e26] p-6 space-y-4 shadow-xs">
					<h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
						Executive Credentials &amp; Background
					</h2>
					<ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-300">
						{data.profile.credentials.map((c) => (
							<li>
								• <strong class="text-slate-900 dark:text-slate-100">{c.label}</strong>
							</li>
						))}
						<li>• <strong class="text-slate-900 dark:text-slate-100">Location:</strong> {data.profile.location} ({data.profile.homeAirport})</li>
						<li>• <strong class="text-slate-900 dark:text-slate-100">Education:</strong> {data.profile.education}</li>
						<li class="flex items-center gap-2 flex-wrap pt-1">
							<AjPrimaryAlt cls="w-5 h-5 shrink-0" />
							<span>
								<strong class="text-slate-900 dark:text-slate-100">Sponsorships &amp; Video Creation:</strong> Explore packages at{" "}
								<a href="https://codingcat.dev/sponsorships" class="text-emerald-700 dark:text-emerald-300 font-semibold underline">
									codingcat.dev/sponsorships
								</a>
							</span>
						</li>
						<li class="flex items-center gap-2 flex-wrap">
							<AjHeadphones cls="w-5 h-5 shrink-0" />
							<span>
								<strong class="text-slate-900 dark:text-slate-100">Podcast &amp; Tutorials:</strong> Published at{" "}
								<a href="https://codingcat.dev" class="text-indigo-600 dark:text-indigo-300 font-semibold underline">
									codingcat.dev
								</a>
							</span>
						</li>
					</ul>
					<div class="pt-3 border-t border-slate-100 dark:border-slate-800">
						<SocialIconsBar socialLinks={data.profile.socialLinks} sizeClass="h-5" />
					</div>
				</section>
			</article>

			<footer role="contentinfo" class="pt-6 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 flex flex-wrap justify-between gap-3">
				<a href="/" class="font-semibold text-slate-700 dark:text-slate-200 hover:underline">Home</a>
				<div class="flex gap-4">
					<a href="/contact" class="hover:underline">Contact &amp; Booking</a>
					<a href="/privacy" class="hover:underline">Privacy</a>
					<a href="/developers" class="text-indigo-600 dark:text-indigo-300 hover:underline">Developers &amp; API</a>
				</div>
			</footer>
		</main>
	</body>
</html>
