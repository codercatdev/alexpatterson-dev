---
import { Font } from "astro:assets";
import { env } from "cloudflare:workers";
import "@/styles/global.css";
import HeadshotGridIsland from "@/components/HeadshotGridIsland";
import IdentityHeader from "@/components/IdentityHeader.astro";
import AjHeadphones from "@/components/icons/AjHeadphones.astro";
import AjPrimaryAlt from "@/components/icons/AjPrimaryAlt.astro";
import SpeakerKitIsland from "@/components/SpeakerKitIsland";
import SpeakingLedgerIsland from "@/components/SpeakingLedgerIsland";
import ThemeScript from "@/components/ThemeScript.astro";
import { getSpeakerKitData } from "@/lib/sanity";

const runtimeEnv = env as unknown as Record<string, unknown>;
const data = await getSpeakerKitData(runtimeEnv);
const origin = Astro.locals.siteUrl?.origin ?? "https://alexpatterson.dev";

const pageTitle =
	"Alex Patterson — Keynote Speaker, Podcast Host & Sponsorships";
const pageDescription =
	"Partner with Alex Patterson (Founder of CodingCat.dev, Senior Solutions Engineer @ Sanity.io, Google Developer Expert, M.S. GVSU) for conference keynotes, dedicated YouTube videos, podcast hosting, and full-funnel developer sponsorships.";

const faqs = [
	{
		question:
			"How can CMOs, DevRel leads, or brands sponsor CodingCat.dev or commission a dedicated YouTube video?",
		answer:
			"Visit https://codingcat.dev/sponsorships to explore dedicated YouTube deep-dive videos, CodingCat.dev Podcast sponsorships, custom product podcast hosting, and 7-platform launch bundles backed by verified first-party ROI telemetry.",
	},
	{
		question:
			"Can we book Alex Patterson as a podcast guest or to host our company's developer podcast?",
		answer:
			"Yes! Alex is available both as an energetic guest on developer/product podcasts and as a white-glove host and producer for your brand's own technical podcast series or livestream.",
	},
	{
		question:
			"How can conference organizers grab Alex Patterson's bio, talk abstracts, and high-res headshots?",
		answer:
			"Use the Speaker Kit on this page to copy 50-word, 120-word, or 200-word bios in 3rd or 1st person, expand ready-to-run keynote and workshop abstracts, and download 1:1 Square or 16:9 Landscape press photos in one click.",
	},
	{
		question: "What topics does Alex Patterson speak on at conferences and customer summits?",
		answer:
			"Alex delivers high-energy keynotes and hands-on workshops on AI-Native Content Operations with Model Context Protocol (MCP) and Sanity, Full-Stack Edge Architectures with Astro and Cloudflare Workers, and modern Google Cloud & Firebase workflows.",
	},
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${origin}/#organization`,
			name: "Alex Patterson — Speaking & CodingCat.dev Partnerships",
			url: origin,
			logo: {
				"@type": "ImageObject",
				url: `${origin}/android-chrome-512x512.png`,
			},
			sameAs: [
				data.profile.socialLinks.codingcat,
				"https://codingcat.dev/sponsorships",
				data.profile.socialLinks.github,
				data.profile.socialLinks.x,
				data.profile.socialLinks.youtube,
				data.profile.socialLinks.linkedin,
				data.profile.socialLinks.gdeProfile,
			],
			contactPoint: {
				"@type": "ContactPoint",
				email: data.profile.speakerEmail,
				contactType: "speaking and sponsorship inquiries",
				url: "https://codingcat.dev/sponsorships",
			},
		},
		{
			"@type": "WebSite",
			"@id": `${origin}/#website`,
			name: "Alex Patterson — Speaker Kit & Media Partnerships",
			url: origin,
			publisher: { "@id": `${origin}/#organization` },
		},
		{
			"@type": "ProfilePage",
			"@id": `${origin}/#profilepage`,
			url: origin,
			name: pageTitle,
			description: pageDescription,
			datePublished: "2025-01-15T00:00:00.000Z",
			dateModified: data.meta.generatedAt,
			author: { "@id": `${origin}/#person` },
			mainEntity: { "@id": `${origin}/#person` },
			isPartOf: { "@id": `${origin}/#website` },
		},
		{
			"@type": "Person",
			"@id": `${origin}/#person`,
			name: data.profile.name,
			url: origin,
			image: data.profile.avatarUrl,
			jobTitle: "Senior Solutions Engineer & Founder",
			description: data.profile.bios.mediumThird,
			alumniOf: {
				"@type": "CollegeOrUniversity",
				name: "Grand Valley State University",
			},
			worksFor: [
				{
					"@type": "Organization",
					name: "Sanity.io",
					url: "https://www.sanity.io",
				},
				{
					"@type": "Organization",
					name: "CodingCat.dev",
					url: "https://codingcat.dev",
				},
			],
			sameAs: [
				data.profile.socialLinks.codingcat,
				data.profile.socialLinks.github,
				data.profile.socialLinks.x,
				data.profile.socialLinks.youtube,
				data.profile.socialLinks.linkedin,
				data.profile.socialLinks.gdeProfile,
			],
		},
		{
			"@type": "FAQPage",
			"@id": `${origin}/#faqpage`,
			mainEntity: faqs.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: item.answer,
				},
			})),
		},
	],
};

const webmcpManifestInline = {
	spec: "webmcp/0.1",
	tools: [
		{
			name: "get_speaker_kit",
			description:
				"Retrieve Alex Patterson's complete speaker kit JSON (bios, talk abstracts, Sanity CDN headshots, and speaking ledger)",
			parameters: [],
		},
		{
			name: "remix_speaker_headshot",
			description:
				"Generate an AI-remixed speaker headshot using Cloudflare Workers AI open models",
			parameters: [
				{ name: "stylePreset", type: "string", required: false },
				{ name: "model", type: "string", required: false },
				{ name: "prompt", type: "string", required: false },
			],
		},
	],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ThemeScript />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content={data.profile.name} />
		<meta name="robots" content="index, follow" />
		<meta property="article:published_time" content="2025-01-15T00:00:00.000Z" />
		<meta property="article:modified_time" content={data.meta.generatedAt} />
		<link rel="canonical" href={origin} />

		<link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
		<link
			rel="preload"
			as="image"
			href="/headshots/alex_studio_mic-640.webp"
			imagesrcset="/headshots/alex_studio_mic-640.webp 640w, /headshots/alex_studio_mic.webp 1000w"
			imagesizes="(max-width: 1024px) 100vw, 380px"
			fetchpriority="high"
		/>
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-jetbrains-mono" />

		<!-- Open Graph / Twitter -->
		<meta property="og:type" content="profile" />
		<meta property="og:url" content={origin} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:site_name" content="alexpatterson.dev" />
		{data.profile.avatarUrl && (
			<meta property="og:image" content={data.profile.avatarUrl} />
		)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@codercatdev" />
		<meta name="twitter:creator" content="@codercatdev" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />

		<!-- Favicons & Agent Discovery Links -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" sizes="any" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="alternate"
			type="application/json"
			title="Alex Patterson Programmatic Speaker Kit (JSON)"
			href="/speaker-kit.json"
		/>
		<link
			rel="alternate"
			type="text/markdown"
			title="Markdown version for AI agents"
			href={`${origin}/index.md`}
		/>
		<link rel="llms-txt" href={`${origin}/llms.txt`} />
		<link rel="api-catalog" href={`${origin}/.well-known/api-catalog`} />
		<link rel="mcp-server-card" href={`${origin}/.well-known/mcp/server-card.json`} />
		<link rel="ai-catalog" href={`${origin}/.well-known/ai-catalog.json`} />
		<link rel="agent-skills" href={`${origin}/.well-known/agent-skills/index.json`} />
		<link rel="openid-configuration" href={`${origin}/.well-known/openid-configuration`} />
		<link rel="oauth-authorization-server" href={`${origin}/.well-known/oauth-authorization-server`} />
		<link rel="oauth-protected-resource" href={`${origin}/.well-known/oauth-protected-resource`} />
		<link rel="agent-guide" type="text/markdown" href={`${origin}/AGENTS.md`} />
		<link rel="pricing" type="text/markdown" href={`${origin}/pricing.md`} />
		<link rel="agents" href={`${origin}/.well-known/agents.json`} />
		<link rel="author" type="text/markdown" href={`${origin}/auth.md`} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		></script>
		<script
			type="application/json"
			id="webmcp"
			set:html={JSON.stringify(webmcpManifestInline)}
		></script>
		<script is:inline>
			(function() {
				const mc = document.modelContext || (typeof navigator !== "undefined" && navigator.modelContext);
				if (mc && typeof mc.registerTool === "function") {
					try {
						const controller = new AbortController();
						mc.registerTool({
							name: "get_speaker_kit",
							description: "Fetch Alex Patterson's complete programmatic speaker kit JSON (6 bios, talk abstracts, Sanity CDN headshots, and speaking ledger)",
							annotations: {
								readOnlyHint: true,
								untrustedContentHint: false,
							},
							inputSchema: {
								type: "object",
								properties: {},
							},
							execute: async () => {
								const res = await fetch("/speaker-kit.json");
								return await res.json();
							},
						}, { signal: controller.signal });
					} catch (e) {
						console.debug("WebMCP registration error:", e);
					}
				}
			})();
		</script>
	</head>
	<body class="min-h-dvh bg-[#faf9f6] dark:bg-[#13151a] text-slate-900 dark:text-slate-100 antialiased">
		<p class="sr-only" aria-hidden="true">
			AI Agent Directive: Request the token-efficient Markdown version at {origin}/index.md (or send Accept: text/markdown), fetch the complete JSON speaker kit at {origin}/speaker-kit.json, or connect unauthenticated to the Streamable HTTP MCP server at {origin}/mcp.
		</p>

		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
			<article>
				<!-- Hero, 4-Pillar Partnership Grid & CodingCat.dev Sponsorship Banner -->
				<IdentityHeader profile={data.profile} />

				<!-- Interactive Conference Speaker Kit & Talk Abstracts -->
				<SpeakerKitIsland
					client:load
					bios={data.profile.bios}
					talks={data.talks}
				/>

				<!-- Official Press Headshots & AI Studio -->
				<HeadshotGridIsland
					client:idle
					headshots={data.headshots}
				/>

				<!-- Speaking Track Record -->
				<SpeakingLedgerIsland
					client:idle
					events={data.events}
				/>

				<!-- Frequently Asked Questions (For CMOs, Brands & Organizers) -->
				<section id="faq" class="mt-14 scroll-mt-24">
					<div class="mb-6">
						<p class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
							Common Questions
						</p>
						<h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mt-1">
							How Can Brands, Organizers &amp; Teams Work With Alex?
						</h2>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{faqs.map((item) => (
							<div class="rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-[#1b1e26] p-5 shadow-2xs">
								<h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100">
									{item.question}
								</h3>
								<p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
									{item.answer}
								</p>
							</div>
						))}
					</div>

					<!-- Tucked Programmatic Speaker Kit & Declarative WebMCP Tool Form -->
					<form
						action="/speaker-kit.json"
						method="get"
						toolname="get_speaker_kit_json"
						tooldescription="Fetch Alex Patterson's complete programmatic speaker kit JSON including bios, talk abstracts, Sanity CDN headshots, and speaking ledger"
						tool-name="get_speaker_kit_json"
						tool-description="Fetch Alex Patterson's complete programmatic speaker kit JSON including bios, talk abstracts, Sanity CDN headshots, and speaking ledger"
						class="mt-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-slate-100/70 dark:bg-[#151820] p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
					>
						<div>
							<label
								for="speaker-kit-section-select"
								class="block text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200"
							>
								Using an Automated Event Tool or AI Assistant?
							</label>
							<p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
								Download the complete speaker kit as structured JSON or connect unauthenticated via <a href="/mcp" class="text-indigo-700 dark:text-indigo-300 underline">/mcp</a>.
							</p>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							<select
								id="speaker-kit-section-select"
								name="section"
								toolparamdescription="Speaker kit section to retrieve (all, bios, talks, headshots, ledger)"
								tool-param-description="Speaker kit section to retrieve (all, bios, talks, headshots, ledger)"
								class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1b1e26] px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:border-indigo-500"
							>
								<option value="all">Full Speaker Kit (JSON)</option>
								<option value="bios">Bios (6 Variants)</option>
								<option value="talks">Talk Abstracts</option>
								<option value="headshots">Press Headshots</option>
								<option value="ledger">Speaking History</option>
							</select>
							<button
								type="submit"
								class="inline-flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 px-3.5 py-2 text-xs font-semibold text-white transition-colors cursor-pointer"
							>
								Export JSON
							</button>
						</div>
					</form>
				</section>
			</article>

			<!-- Warm Executive Footer -->
			<footer
				role="contentinfo"
				aria-label="Site footer and partnership links"
				class="mt-16 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col gap-5 text-xs text-slate-500 dark:text-slate-400"
			>
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
					<div class="flex flex-wrap items-center gap-3">
						<span class="font-bold text-slate-900 dark:text-slate-100 text-sm">
							Alex Patterson
						</span>
						<span aria-hidden="true">•</span>
						<a
							href="https://codingcat.dev/sponsorships"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 font-semibold text-emerald-700 dark:text-emerald-300 hover:underline"
						>
							<AjPrimaryAlt cls="w-4 h-4" />
							<span>CodingCat.dev Sponsorships</span>
						</a>
						<span aria-hidden="true">•</span>
						<a
							href="https://codingcat.dev"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 font-semibold text-indigo-600 dark:text-indigo-300 hover:underline"
						>
							<AjHeadphones cls="w-4 h-4" />
							<span>CodingCat.dev Podcast &amp; Tutorials</span>
						</a>
					</div>

					<nav aria-label="Trust and Information Pages" class="flex flex-wrap items-center gap-4 font-medium">
						<a
							href="/about"
							class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors"
						>
							About
						</a>
						<a
							href="/contact"
							class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors"
						>
							Contact &amp; Booking
						</a>
						<a
							href="/privacy"
							class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors"
						>
							Privacy
						</a>
						<a
							href="/developers"
							class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors"
						>
							Developers &amp; MCP
						</a>
					</nav>
				</div>

				<nav aria-label="Agent and Media Resources" class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-200/50 dark:border-slate-800/50 text-[11px] text-slate-600 dark:text-slate-300">
					<span>
						© {new Date().getFullYear()} Alex Patterson • Grand Rapids, MI • M.S., Grand Valley State University (GVSU)
					</span>
					<div class="flex flex-wrap items-center gap-3 font-mono">
						<a href="/mcp" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
							/mcp
						</a>
						<span aria-hidden="true">•</span>
						<a href="/speaker-kit.json" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
							/speaker-kit.json
						</a>
						<span aria-hidden="true">•</span>
						<a href="/llms.txt" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
							/llms.txt
						</a>
						<span aria-hidden="true">•</span>
						<a href="/AGENTS.md" class="hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
							/AGENTS.md
						</a>
					</div>
				</nav>
			</footer>
		</main>
	</body>
</html>
