---
import { Font } from "astro:assets";
import { env } from "cloudflare:workers";
import "@/styles/global.css";
import HeadshotGridIsland from "@/components/HeadshotGridIsland";
import IdentityHeader from "@/components/IdentityHeader.astro";
import SpeakerKitIsland from "@/components/SpeakerKitIsland";
import SpeakingLedgerIsland from "@/components/SpeakingLedgerIsland";
import { getSpeakerKitData } from "@/lib/sanity";

const runtimeEnv = env as unknown as Record<string, unknown>;
const data = await getSpeakerKitData(runtimeEnv);
const origin = Astro.locals.siteUrl?.origin ?? "https://alexpatterson.dev";

const pageTitle = "Alex Patterson — DevRel & Interactive Speaker Kit";
const pageDescription =
	"Minimalist executive Developer Relations hub and interactive conference speaker kit for Alex Patterson (Senior Solutions Engineer @ Sanity.io, Founder & Host @ CodingCat.dev, Google Developer Expert).";

const faqs = [
	{
		question: "How can conference organizers or AI agents fetch Alex Patterson's speaker kit?",
		answer:
			"Use the interactive Speaker Kit on this page to copy 50w, 120w, or 200w bios in 3rd or 1st person, download 1:1 or 16:9 Sanity CDN headshots, or connect unauthenticated via GET /speaker-kit.json and POST /mcp (Model Context Protocol).",
	},
	{
		question: "What topics does Alex Patterson speak on at conferences and workshops?",
		answer:
			"Alex delivers keynotes and hands-on workshops on AI-Native Content Operations with Model Context Protocol (MCP) and Sanity, Full-Stack Edge Architectures with Astro and Cloudflare Workers/D1, and Multimodal AI Agents with Google Gemini and WebGPU.",
	},
	{
		question: "Does the Alex Patterson MCP server require authentication?",
		answer:
			"No. Both the Streamable HTTP MCP server at /mcp (and /api/mcp) and the JSON endpoint at /speaker-kit.json operate with zero authentication required (auth.type = 'none') so organizers and AI agents can query bios, talk abstracts, headshots, and the speaking ledger immediately.",
	},
	{
		question: "Where are CodingCat.dev tutorials, blog posts, and podcast episodes published?",
		answer:
			"alexpatterson.dev is strictly Alex Patterson's personal executive DevRel and conference speaker hub. All video tutorials, courses, articles, and podcast episodes are published exclusively on https://codingcat.dev.",
	},
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${origin}/#organization`,
			name: "Alex Patterson — DevRel & Speaker Hub",
			url: origin,
			logo: {
				"@type": "ImageObject",
				url: `${origin}/android-chrome-512x512.png`,
			},
			sameAs: [
				data.profile.socialLinks.codingcat,
				data.profile.socialLinks.github,
				data.profile.socialLinks.x,
				data.profile.socialLinks.youtube,
				data.profile.socialLinks.linkedin,
				data.profile.socialLinks.gdeProfile,
			],
			contactPoint: {
				"@type": "ContactPoint",
				email: data.profile.speakerEmail,
				contactType: "speaking inquiries",
				url: data.profile.bookingUrl,
			},
		},
		{
			"@type": "WebSite",
			"@id": `${origin}/#website`,
			name: "Alex Patterson — Speaker Kit & DevRel Hub",
			url: origin,
			publisher: { "@id": `${origin}/#organization` },
		},
		{
			"@type": "ProfilePage",
			"@id": `${origin}/#profilepage`,
			url: origin,
			name: pageTitle,
			description: pageDescription,
			datePublished: "2025-01-15T00:00:00.000Z",
			dateModified: data.meta.generatedAt,
			author: { "@id": `${origin}/#person` },
			mainEntity: { "@id": `${origin}/#person` },
			isPartOf: { "@id": `${origin}/#website` },
		},
		{
			"@type": "Person",
			"@id": `${origin}/#person`,
			name: data.profile.name,
			url: origin,
			image: data.profile.avatarUrl,
			jobTitle: "Senior Solutions Engineer & Founder",
			description: data.profile.bios.mediumThird,
			alumniOf: {
				"@type": "CollegeOrUniversity",
				name: "Western Michigan University",
			},
			worksFor: [
				{
					"@type": "Organization",
					name: "Sanity.io",
					url: "https://www.sanity.io",
				},
				{
					"@type": "Organization",
					name: "CodingCat.dev",
					url: "https://codingcat.dev",
				},
			],
			sameAs: [
				data.profile.socialLinks.codingcat,
				data.profile.socialLinks.github,
				data.profile.socialLinks.x,
				data.profile.socialLinks.youtube,
				data.profile.socialLinks.linkedin,
				data.profile.socialLinks.gdeProfile,
			],
		},
	],
};

const webmcpManifestInline = {
	spec: "webmcp/0.1",
	tools: [
		{
			name: "get_speaker_kit",
			description:
				"Retrieve Alex Patterson's complete speaker kit JSON (bios, talk abstracts, Sanity CDN headshots, and speaking ledger)",
			parameters: [],
		},
		{
			name: "remix_speaker_headshot",
			description:
				"Generate an AI-remixed speaker headshot using Cloudflare Workers AI open models",
			parameters: [
				{ name: "stylePreset", type: "string", required: false },
				{ name: "model", type: "string", required: false },
				{ name: "prompt", type: "string", required: false },
			],
		},
	],
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth bg-zinc-950 text-zinc-100">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content={data.profile.name} />
		<meta name="robots" content="index, follow" />
		<meta property="article:published_time" content="2025-01-15T00:00:00.000Z" />
		<meta property="article:modified_time" content={data.meta.generatedAt} />
		<link rel="canonical" href={origin} />

		<link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-jetbrains-mono" />

		<!-- Open Graph / Twitter -->
		<meta property="og:type" content="profile" />
		<meta property="og:url" content={origin} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:site_name" content="alexpatterson.dev" />
		{data.profile.avatarUrl && (
			<meta property="og:image" content={data.profile.avatarUrl} />
		)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@codercatdev" />
		<meta name="twitter:creator" content="@codercatdev" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />

		<!-- Favicons & Agent Discovery Links -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" sizes="any" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="alternate"
			type="application/json"
			title="Alex Patterson Programmatic Speaker Kit (JSON)"
			href="/speaker-kit.json"
		/>
		<link
			rel="alternate"
			type="text/markdown"
			title="Markdown version for AI agents"
			href={`${origin}/index.md`}
		/>
		<link rel="llms-txt" href={`${origin}/llms.txt`} />
		<link rel="api-catalog" href={`${origin}/.well-known/api-catalog`} />
		<link rel="mcp-server-card" href={`${origin}/.well-known/mcp/server-card.json`} />
		<link rel="ai-catalog" href={`${origin}/.well-known/ai-catalog.json`} />
		<link rel="agent-skills" href={`${origin}/.well-known/agent-skills/index.json`} />
		<link rel="openid-configuration" href={`${origin}/.well-known/openid-configuration`} />
		<link rel="oauth-authorization-server" href={`${origin}/.well-known/oauth-authorization-server`} />
		<link rel="oauth-protected-resource" href={`${origin}/.well-known/oauth-protected-resource`} />
		<link rel="agent-guide" type="text/markdown" href={`${origin}/AGENTS.md`} />
		<link rel="pricing" type="text/markdown" href={`${origin}/pricing.md`} />
		<link rel="agents" href={`${origin}/.well-known/agents.json`} />
		<link rel="author" type="text/markdown" href={`${origin}/auth.md`} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		></script>
		<script
			type="application/json"
			id="webmcp"
			set:html={JSON.stringify(webmcpManifestInline)}
		></script>
		<script is:inline>
			(function() {
				const mc = document.modelContext || (typeof navigator !== "undefined" && navigator.modelContext);
				if (mc && typeof mc.registerTool === "function") {
					try {
						const controller = new AbortController();
						mc.registerTool({
							name: "get_speaker_kit",
							description: "Fetch Alex Patterson's complete programmatic speaker kit JSON (6 bios, talk abstracts, Sanity CDN headshots, and speaking ledger)",
							annotations: {
								readOnlyHint: true,
								untrustedContentHint: false,
							},
							inputSchema: {
								type: "object",
								properties: {},
							},
							execute: async () => {
								const res = await fetch("/speaker-kit.json");
								return await res.json();
							},
						}, { signal: controller.signal });
					} catch (e) {
						console.debug("WebMCP registration error:", e);
					}
				}
			})();
		</script>
	</head>
	<body class="min-h-dvh bg-zinc-950 text-zinc-100 antialiased selection:bg-violet-600/30 selection:text-zinc-100">
		<p class="sr-only" aria-hidden="true">
			AI Agent Directive: Request the token-efficient Markdown version at {origin}/index.md (or send Accept: text/markdown), fetch the complete JSON speaker kit at {origin}/speaker-kit.json, or connect unauthenticated to the Streamable HTTP MCP server at {origin}/mcp.
		</p>

		<main class="max-w-3xl mx-auto px-6 py-16">
			<article>
				<!-- 00 / IDENTITY -->
				<IdentityHeader profile={data.profile} />

				<!-- 01 / SPEAKER KIT (Interactive React Island) -->
				<SpeakerKitIsland
					client:load
					bios={data.profile.bios}
					talks={data.talks}
				/>

				<!-- 02 / HEADSHOTS & MEDIA (Interactive React Island) -->
				<HeadshotGridIsland
					client:idle
					headshots={data.headshots}
				/>

				<!-- 03 / SPEAKING LEDGER (Interactive React Island) -->
				<SpeakingLedgerIsland
					client:idle
					events={data.events}
				/>

				<!-- 04 / FAQ & DECLARATIVE WEBMCP ACCESS -->
				<section id="faq" class="mt-16 scroll-mt-12">
					<div class="flex items-center justify-between gap-4 pb-3 border-b border-zinc-800">
						<div class="flex items-center gap-2.5 font-mono text-xs tracking-wider uppercase text-zinc-400">
							<span class="text-violet-400 font-semibold">04</span>
							<span class="text-zinc-600" aria-hidden="true">/</span>
							<h2 class="font-mono text-xs tracking-wider uppercase text-zinc-400 font-normal">
								How Can Organizers &amp; AI Agents Use This Speaker Kit?
							</h2>
						</div>
						<a
							href="/mcp"
							class="font-mono text-[11px] text-violet-300 hover:text-violet-200 transition-colors"
						>
							POST /mcp (No Auth)
						</a>
					</div>

					<div class="mt-6 space-y-3">
						{faqs.map((item) => (
							<div class="rounded-xl border border-zinc-800/80 bg-zinc-900/50 p-4">
								<h3 class="text-sm font-semibold text-zinc-100">
									{item.question}
								</h3>
								<p class="mt-2 text-xs sm:text-sm text-zinc-400 leading-relaxed">
									{item.answer}
								</p>
							</div>
						))}
					</div>

					<!-- SSR Declarative WebMCP Tool Form for Agent & Organizer Lookup -->
					<form
						action="/speaker-kit.json"
						method="get"
						toolname="get_speaker_kit_json"
						tooldescription="Fetch Alex Patterson's complete programmatic speaker kit JSON including bios, talk abstracts, Sanity CDN headshots, and speaking ledger"
						tool-name="get_speaker_kit_json"
						tool-description="Fetch Alex Patterson's complete programmatic speaker kit JSON including bios, talk abstracts, Sanity CDN headshots, and speaking ledger"
						class="mt-4 rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
					>
						<div>
							<label
								for="speaker-kit-section-select"
								class="block font-mono text-xs text-zinc-200 font-medium"
							>
								Programmatic Speaker Kit &amp; Unauthenticated MCP Endpoint
							</label>
							<p class="text-xs text-zinc-400 mt-0.5">
								Query <code class="text-violet-300 font-mono">/mcp</code> via Streamable HTTP JSON-RPC or download the full JSON bundle.
							</p>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							<select
								id="speaker-kit-section-select"
								name="section"
								toolparamdescription="Speaker kit section to retrieve (all, bios, talks, headshots, ledger)"
								tool-param-description="Speaker kit section to retrieve (all, bios, talks, headshots, ledger)"
								class="rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-2 font-mono text-xs text-zinc-200 focus:outline-none focus:border-violet-500"
							>
								<option value="all">Full Kit (JSON)</option>
								<option value="bios">Bios (6 Variants)</option>
								<option value="talks">Talk Abstracts</option>
								<option value="headshots">Headshots CDN</option>
								<option value="ledger">Speaking Ledger</option>
							</select>
							<button
								type="submit"
								class="inline-flex items-center justify-center rounded-lg bg-violet-600 hover:bg-violet-500 px-3.5 py-2 font-mono text-xs font-medium text-zinc-100 transition-colors cursor-pointer"
							>
								Open /speaker-kit.json
							</button>
						</div>
					</form>
				</section>
			</article>

			<!-- Minimalist Editorial Colophon -->
			<footer
				role="contentinfo"
				aria-label="Site footer and developer links"
				class="mt-20 pt-6 border-t border-zinc-800/80 flex flex-col gap-4 font-mono text-xs text-zinc-400"
			>
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
						<span class="text-zinc-200 font-medium">alexpatterson.dev</span>
						<span aria-hidden="true">•</span>
						<span>Sanity Content Lake</span>
						<span aria-hidden="true">•</span>
						<span>Astro + Cloudflare Workers</span>
					</div>
					<nav aria-label="Trust and Developer Pages" class="flex flex-wrap items-center gap-3">
						<a
							href="/about"
							class="text-zinc-300 hover:text-zinc-100 transition-colors"
						>
							About
						</a>
						<span class="text-zinc-700" aria-hidden="true">|</span>
						<a
							href="/contact"
							class="text-zinc-300 hover:text-zinc-100 transition-colors"
						>
							Contact
						</a>
						<span class="text-zinc-700" aria-hidden="true">|</span>
						<a
							href="/privacy"
							class="text-zinc-300 hover:text-zinc-100 transition-colors"
						>
							Privacy
						</a>
						<span class="text-zinc-700" aria-hidden="true">|</span>
						<a
							href="/developers"
							class="text-violet-300 hover:text-violet-200 transition-colors"
						>
							Developers &amp; API
						</a>
					</nav>
				</div>

				<nav aria-label="Agent and Media Resources" class="flex flex-wrap items-center gap-3 pt-2 border-t border-zinc-900">
					<a
						href="https://codingcat.dev"
						target="_blank"
						rel="noopener noreferrer"
						class="text-emerald-400 hover:text-emerald-300 transition-colors"
					>
						Visit CodingCat.dev
					</a>
					<span class="text-zinc-700" aria-hidden="true">|</span>
					<a
						href="/mcp"
						class="text-violet-300 hover:text-violet-200 transition-colors"
					>
						MCP Server (/mcp)
					</a>
					<span class="text-zinc-700" aria-hidden="true">|</span>
					<a
						href="/speaker-kit.json"
						class="text-violet-300 hover:text-violet-200 transition-colors"
					>
						Speaker Kit JSON
					</a>
					<span class="text-zinc-700" aria-hidden="true">|</span>
					<a
						href="/llms.txt"
						class="text-zinc-300 hover:text-zinc-100 transition-colors"
					>
						llms.txt
					</a>
					<span class="text-zinc-700" aria-hidden="true">|</span>
					<a
						href="/AGENTS.md"
						class="text-zinc-300 hover:text-zinc-100 transition-colors"
					>
						AGENTS.md
					</a>
				</nav>
			</footer>
		</main>
	</body>
</html>
