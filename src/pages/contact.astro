---
import { env } from "cloudflare:workers";
import { Font } from "astro:assets";
import { getSpeakerKitData } from "@/lib/sanity";
import "@/styles/global.css";

const runtimeEnv = env as unknown as Record<string, unknown>;
const data = await getSpeakerKitData(runtimeEnv);
const origin = Astro.locals.siteUrl?.origin ?? "https://alexpatterson.dev";
---

<!doctype html>
<html lang="en" class="dark scroll-smooth bg-zinc-950 text-zinc-100">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Contact &amp; Book Alex Patterson — Speaking &amp; Advisory Inquiries</title>
		<meta
			name="description"
			content="Contact Alex Patterson for conference keynotes, technical workshops, Google Developer Expert briefings, and enterprise architecture advisory."
		/>
		<link rel="canonical" href={`${origin}/contact`} />
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-jetbrains-mono" />
	</head>
	<body class="min-h-dvh bg-zinc-950 text-zinc-100 antialiased">
		<main class="max-w-3xl mx-auto px-6 py-16 space-y-8">
			<header role="banner" class="pb-4 border-b border-zinc-800 flex items-center justify-between">
				<div class="font-mono text-xs uppercase tracking-wider text-zinc-400">
					<span class="text-violet-400 font-semibold">01</span> / CONTACT &amp; SPEAKER BOOKING
				</div>
				<a href="/" class="font-mono text-xs text-violet-300 hover:text-violet-200">
					← Back to Speaker Kit
				</a>
			</header>

			<article class="space-y-6">
				<h1 class="text-2xl sm:text-3xl font-bold text-zinc-100">
					Contact &amp; Invite {data.profile.name} to Speak
				</h1>
				<p class="text-sm sm:text-base text-zinc-300 leading-relaxed">
					Conference organizers, event producers, and engineering leaders can reach {data.profile.name} directly for keynote invitations, hands-on workshops, panel moderation, and architecture briefings. Based in {data.profile.location} and flying out of {data.profile.homeAirport}, Alex is available for both in-person international events and broadcast-grade virtual sessions from the CodingCat.dev studio.
				</p>

				<section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 space-y-2">
						<h2 class="font-mono text-xs uppercase text-violet-300">Direct Speaker Email</h2>
						<p class="text-xs text-zinc-400">
							Include event dates, city/venue or virtual platform, audience profile, and session format.
						</p>
						<a href={`mailto:${data.profile.speakerEmail}`} class="inline-block font-mono text-sm text-zinc-100 underline">
							{data.profile.speakerEmail}
						</a>
					</div>

					<div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 space-y-2">
						<h2 class="font-mono text-xs uppercase text-emerald-400">Online Booking Calendar</h2>
						<p class="text-xs text-zinc-400">
							Schedule a direct 30-minute coordination call or podcast/media booking slot.
						</p>
						<a href={data.profile.bookingUrl} target="_blank" rel="noopener noreferrer" class="inline-block font-mono text-sm text-emerald-300 underline">
							{data.profile.bookingUrl}
						</a>
					</div>
				</section>
			</article>

			<footer role="contentinfo" class="pt-6 border-t border-zinc-800 font-mono text-xs text-zinc-400 flex flex-wrap justify-between gap-3">
				<a href="/" class="text-zinc-300 hover:text-zinc-100">Home</a>
				<div class="flex gap-4">
					<a href="/about" class="hover:text-zinc-200">About</a>
					<a href="/privacy" class="hover:text-zinc-200">Privacy</a>
					<a href="/developers" class="text-violet-300 hover:text-violet-200">Developers &amp; API</a>
				</div>
			</footer>
		</main>
	</body>
</html>
